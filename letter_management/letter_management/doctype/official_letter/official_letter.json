{
 "doctype": "DocType",
 "name": "Official Letter",
 "module": "Letter Management",
 "custom": 0,
 "istable": 0,
 "issingle": 0,
 "is_submittable": 1,
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Series",
   "fieldtype": "Select",
   "options": "LTR-.YYYY.-.#####",
   "default": "LTR-.YYYY.-.#####",
   "hidden": 1,
   "description": "This series is the official letter reference/serial number."
  },
  {
   "fieldname": "company",
   "label": "Company",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "letter_head",
   "label": "Letter Head",
   "fieldtype": "Link",
   "options": "Letter Head",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Filtered to the selected Company's letterheads. Auto-selected if the Company has only one."
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Letter Content"
  },
  {
   "fieldname": "letter_content",
   "label": "Letter Content",
   "fieldtype": "Text Editor",
   "reqd": 1
  },
  {
   "fieldname": "amended_from",
   "label": "Amended From",
   "fieldtype": "Link",
   "options": "Official Letter",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  }
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "email": 1, "export": 1, "share": 1
  },
  {
   "role": "Letter Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "submit": 1, "cancel": 1, "amend": 1, "print": 1, "email": 1, "export": 1, "share": 1
  },
  {
   "role": "Letter User",
   "read": 1, "print": 1
  }
 ]
}
